---
import BaseLayout from "../layouts/BaseLayout.astro";
import Navbar from "../components/Navbar.astro";
import Hero from "../components/Hero.astro";
import WhatWeDo from "../components/WhatWeDo.astro";
import Solutions from "../components/Solutions.astro";
import HowWeWork from "../components/HowWeWork.astro";
import Areas from "../components/Areas.astro";
import Team from "../components/Team.astro";
import Network from "../components/Network.astro";
import Contact from "../components/Contact.astro";
import Footer from "../components/Footer.astro";
import { getContent } from "../i18n/getContent";

const lang = "es";
const c = await getContent(lang);
---

<BaseLayout
  lang={lang}
  title="Contextual — Soluciones a problemas públicos complejos"
>
  <Navbar nav={c.nav} lang={lang} />
  <main class="flex flex-col gap-40">
    <Hero hero={c.hero} />
    <WhatWeDo what={c.what} />
    <Solutions solutions={c.solutions} />
    <HowWeWork how={c.how} />
    <Areas areas={c.areas} />
    <Team team={c.team} />
    <Network network={c.network} />
    <Contact contact={c.contact} />
  </main>
  <Footer footer={c.footer} lang={lang} />
</BaseLayout>
