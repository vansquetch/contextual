---
import BaseLayout from "../layouts/BaseLayout.astro";
import Navbar from "../components/Navbar.astro";
import Hero from "../components/Hero.astro";
import WhatWeDo from "../components/WhatWeDo.astro";
import Solutions from "../components/Solutions.astro";
import HowWeWork from "../components/HowWeWork.astro";
import Areas from "../components/Areas.astro";
import Team from "../components/Team.astro";
import Network from "../components/Network.astro";
import Contact from "../components/Contact.astro";
import Footer from "../components/Footer.astro";
import {
  getContent,
  getContentConfig,
  getContentMedia,
  localizeContent,
} from "../services/content.service";

const lang = "es";
const c = localizeContent(await getContent(), lang);
const m = await getContentMedia();
const conf = await getContentConfig();
---

<BaseLayout
  lang={lang}
  title="Contextual — Soluciones a problemas públicos complejos"
>
  <Navbar nav={c.nav} lang={lang} />
  <main class="flex flex-col">
    <Hero hero={c.hero} media={m.hero} />
    <WhatWeDo what={c.what} />
    <Solutions solutions={c.solutions} />
    <HowWeWork how={c.how} />
    <Areas areas={c.areas} />
    <Team team={c.team} media={m.team} />
    <Network network={c.network} media={m.network} />
    <Contact contact={c.contact} data={conf.footer} />
  </main>
  <Footer footer={c.footer} lang={lang} />
</BaseLayout>
