---
interface Props {
  footer: { location: string; email: string; site: string };
  lang: "es" | "en";
}

const { footer, lang } = Astro.props;
---

<footer class="bg-primary-500 text-white py-12">
  <div class="container-site">
    <nav aria-label="Footer navigation">
      <ul
        class="flex flex-wrap justify-center gap-x-6 gap-y-2 list-none text-sm"
      >
        {
          [
            {
              href: "#what",
              label: lang === "es" ? "Qué hacemos" : "What we do",
            },
            {
              href: "#solutions",
              label: lang === "es" ? "Soluciones" : "Solutions",
            },
            { href: "#team", label: lang === "es" ? "Equipo" : "Team" },
            {
              href: "#contact",
              label: lang === "es" ? "Contacto" : "Contact",
            },
          ].map(({ href, label }) => (
            <li>
              <a
                href={href}
                class="text-secondary-500 hover:text-surface no-underline transition-colors duration-200"
              >
                {label}
              </a>
            </li>
          ))
        }
      </ul>
    </nav>
  </div>
</footer>
