---
interface Props {
  footer: { location: string; email: string; site: string };
  lang: "es" | "en";
}

const { footer, lang } = Astro.props;
---

<footer class="bg-[var(--color-ink)] text-[var(--color-secondary-400)] py-12">
  <div class="container-site">
    <div class="flex flex-col md:flex-row justify-between items-start md:items-center gap-8">
      <!-- Logo + location -->
      <div class="flex flex-col gap-3">
        <div class="flex items-center gap-2 text-[var(--color-surface)]">
          <svg width="18" height="18" viewBox="0 0 20 20" fill="none" aria-hidden="true">
            <circle cx="10" cy="10" r="9" stroke="currentColor" stroke-width="1.5"/>
            <path d="M10 4 L10 16 M4 10 L16 10" stroke="currentColor" stroke-width="1.5"/>
          </svg>
          <span class="type-medium font-semibold tracking-tight text-[var(--color-surface)]">
            Contextual
          </span>
        </div>
        <p class="type-normal text-sm text-[var(--color-secondary-500)]">
          {footer.location}
        </p>
      </div>

      <!-- Contact links -->
      <div class="flex flex-col gap-2 text-sm">
        <a
          href={`mailto:${footer.email}`}
          class="text-[var(--color-secondary-400)] hover:text-[var(--color-surface)] no-underline transition-colors duration-200"
        >
          {footer.email}
        </a>
        <a
          href={`https://${footer.site}`}
          target="_blank"
          rel="noopener noreferrer"
          class="text-[var(--color-secondary-500)] hover:text-[var(--color-surface)] no-underline transition-colors duration-200"
        >
          {footer.site}
        </a>
      </div>

      <!-- Nav links -->
      <nav aria-label="Footer navigation">
        <ul class="flex flex-wrap gap-x-6 gap-y-2 list-none text-sm">
          {[
            { href: "#what", label: lang === "es" ? "Qué hacemos" : "What we do" },
            { href: "#solutions", label: lang === "es" ? "Soluciones" : "Solutions" },
            { href: "#team", label: lang === "es" ? "Equipo" : "Team" },
            { href: "#contact", label: lang === "es" ? "Contacto" : "Contact" },
          ].map(({ href, label }) => (
            <li>
              <a
                href={href}
                class="text-[var(--color-secondary-500)] hover:text-[var(--color-surface)] no-underline transition-colors duration-200"
              >
                {label}
              </a>
            </li>
          ))}
        </ul>
      </nav>
    </div>

    <!-- Bottom bar -->
    <div
      class="mt-10 pt-6 border-t border-[var(--color-ink-muted)] flex flex-col sm:flex-row justify-between items-start sm:items-center gap-2 text-xs text-[var(--color-ink-muted)]"
    >
      <p>© {new Date().getFullYear()} Contextual. {lang === "es" ? "Todos los derechos reservados." : "All rights reserved."}</p>
    </div>
  </div>
</footer>
