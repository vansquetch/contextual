---
import { getImageUrl } from "../services/image.service";
import type { MediaContent } from "../types/content";
import PrincipalTitle from "./ui/PrincipalTitle.astro";
import RichText from "./ui/RichText.astro";

interface Props {
  network: { title: string; body: string; label: string };
  media: MediaContent["network"];
}

const { network, media } = Astro.props;

// Partner logos — replace src with actual logo files in /public/logos/
const partners = [
  {
    id: "nyu",
    name: "NYU — Center on International Cooperation",
    logo: getImageUrl(media.nyu),
  },
  {
    id: "peace",
    name: "Peace in Our Cities",
    logo: getImageUrl(media.peace),
  },
  {
    id: "worldjustice",
    name: "World Justice Project",
    logo: getImageUrl(media.world),
  },
];
---

<section id="network" class="section-gap bg-secondary-100">
  <div class="container-site">
    <!-- Section header -->
    <div class="mb-10 text-center">
      <PrincipalTitle>{network.title}</PrincipalTitle>
    </div>

    <RichText
      class="type-normal text-ink-muted mb-12 text-center"
      html={network.body}
    />

    <p class="text-ink-muted text-center tracking-widest font-semibold mb-8">
      {network.label}
    </p>

    <!-- Logo strip -->
    <div class="flex flex-wrap items-center justify-center gap-12">
      {
        partners.map((p) => (
          <div class="h-14 flex items-center opacity-60 hover:opacity-100 transition-opacity duration-200 grayscale hover:grayscale-0">
            <img
              src={p.logo}
              alt={p.name}
              class="h-full w-auto object-contain"
              loading="lazy"
              onerror={`this.parentElement.innerHTML='<span class="type-normal text-sm text-ink-muted font-medium">${p.name}</span>'`}
            />
          </div>
        ))
      }
    </div>
  </div>
</section>
