---
import PrincipalTitle from './ui/PrincipalTitle.astro';
import RichText from './ui/RichText.astro';

interface SolutionItem {
  id: string;
  title: string;
  body: string;
}

interface Props {
  solutions: { title: string; items: SolutionItem[] };
}

const { solutions } = Astro.props;
---

<section id="solutions" class="section-gap bg-surface raya-derecha">
  <div class="container-site">
    <!-- Section header -->
    <div class="mb-14 text-center">
      <PrincipalTitle>{solutions.title}</PrincipalTitle>
    </div>

    <!-- Solutions list — stacked with a vertical left border accent -->
    <div class="flex flex-col gap-6 max-w-xl m-auto">
      {
        solutions.items.map((item, i) => (
          <div
            class="group flex gap-2 py-3  border-b border-primary-300"
          >
            <!-- Index marker -->
            {/* <div
              class="flex flex-col items-center pt-1"
              aria-hidden="true"
            >
              <span class="type-normal text-xs text-accent-500 font-semibold tabular-nums w-8 text-right">
                0{i + 1}
              </span>
            </div> */}

            <!-- Content -->
            <div class="flex-1">
              <h3 class="type-medium text-ink mb-3 group-hover:text-primary-500 transition-colors duration-200 font-work">
                {item.title}
              </h3>
                <RichText class="type-normal max-w-2xl" html={item.body} />
            </div>

            
          </div>
        ))
      }
    </div>
  </div>
</section>
