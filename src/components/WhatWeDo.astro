---
import PrincipalTitle from './ui/PrincipalTitle.astro';

interface ServiceItem {
  id: string;
  title: string;
  body: string;
}

interface Props {
  what: { title: string; items: ServiceItem[] };
}

const { what } = Astro.props;


const icons: Record<string, string> = {
  security: `<path fill="currentColor" d="M12 22q-3.475-.875-5.738-3.988T4 11.1V5l8-3l8 3v6.1q0 3.8-2.262 6.913T12 22m0-2.1q2.6-.825 4.3-3.3t1.7-5.5V6.375l-6-2.25l-6 2.25V11.1q0 3.025 1.7 5.5t4.3 3.3m0-7.9"/>`,
  urban: `<path fill="currentColor" d="M23 5v14q0 .825-.587 1.413T21 21h-3q-.425 0-.712-.288T17 20t.288-.712T18 19h3V5h-9v.5q0 .425-.288.713T11 6.5t-.712-.288T10 5.5v-.55q0-.8.575-1.375T11.95 3H21q.825 0 1.413.588T23 5M1 12.025q0-.5.225-.925t.625-.7l5-3.575q.275-.2.563-.288T8 6.45t.588.088t.562.287l5 3.575q.4.275.625.7t.225.925V19q0 .825-.587 1.413T13 21h-2q-.825 0-1.412-.587T9 19v-3H7v3q0 .825-.587 1.413T5 21H3q-.825 0-1.412-.587T1 19zM3 12v7h2v-3q0-.825.588-1.412T7 14h2q.825 0 1.413.588T11 16v3h2v-7L8 8.45zm8 7v-5H5v5v-5h6zm6.5-10h1q.2 0 .35-.15T19 8.5v-1q0-.2-.15-.35T18.5 7h-1q-.2 0-.35.15T17 7.5v1q0 .2.15.35t.35.15m0 4h1q.2 0 .35-.15t.15-.35v-1q0-.2-.15-.35T18.5 11h-1q-.2 0-.35.15t-.15.35v1q0 .2.15.35t.35.15m0 4h1q.2 0 .35-.15t.15-.35v-1q0-.2-.15-.35T18.5 15h-1q-.2 0-.35.15t-.15.35v1q0 .2.15.35t.35.15"/>`,
  delivery: `<path fill="currentColor" d="M5 21q-.825 0-1.412-.587T3 19V5q0-.825.588-1.412T5 3h14q.2 0 .375.038t.35.112L17.875 5H5v14h14v-6.65l2-2V19q0 .825-.587 1.413T19 21zm6.525-4l-5.65-5.65l1.4-1.4l4.25 4.25L20.7 5.025L22.125 6.4z"/>`,
  innovation: `<path fill="currentColor" d="M12 8a4 4 0 1 1-3.995 4.2L8 12l.005-.2A4 4 0 0 1 12 8m0-6a1 1 0 0 1 .993.883L13 3v2a1 1 0 0 1-1.993.117L11 5V3a1 1 0 0 1 1-1m5.693 2.893a1 1 0 0 1 1.497 1.32l-.083.094l-1.4 1.4a1 1 0 0 1-1.497-1.32l.083-.094zM21 11a1 1 0 0 1 .117 1.993L21 13h-2a1 1 0 0 1-.117-1.993L19 11zm-4.707 5.293a1 1 0 0 1 1.32-.083l.094.083l1.4 1.4a1 1 0 0 1-1.32 1.497l-.094-.083l-1.4-1.4a1 1 0 0 1 0-1.414M12 18a1 1 0 0 1 .993.883L13 19v2a1 1 0 0 1-1.993.117L11 21v-2a1 1 0 0 1 1-1m-5.707-1.707a1 1 0 0 1 1.497 1.32l-.083.094l-1.4 1.4a1 1 0 0 1-1.497-1.32l.083-.094zM6 11a1 1 0 0 1 .117 1.993L6 13H4a1 1 0 0 1-.117-1.993L4 11zM4.893 4.893a1 1 0 0 1 1.32-.083l.094.083l1.4 1.4a1 1 0 0 1-1.32 1.497l-.094-.083l-1.4-1.4a1 1 0 0 1 0-1.414"/>`,
};
---

<section id="what" class="section-gap">
  <div class="container-site">
    <!-- Section header -->
    <div class="mb-14 text-center">
      <PrincipalTitle>{what.title}</PrincipalTitle>
    
    </div>

    <!-- Grid -->
    <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
      {
        what.items.map((item) => (
          <article
            class="group p-8 bg-secondary-500 border border-secondary-400 hover:border-primary-300 transition-colors duration-300"
          >
            <!-- Icon -->
            <div
              class="mb-2 w-10 h-10 flex items-center justify-center rounded-full bg-primary-500  text-white transition-colors duration-300"
            >
              <svg
                width="20"
                height="20"
                viewBox="0 0 24 24"
                fill="none"
                aria-hidden="true"
                set:html={icons[item.id] ?? icons.delivery}
              />
            </div>

            <h3 class="type-t4 text-ink mb-3">
              {item.title}
            </h3>
            <p class="type-normal text-ink-muted">{item.body}</p>
          </article>
        ))
      }
    </div>
  </div>
</section>
