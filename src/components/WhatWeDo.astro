---
import PrincipalTitle from './ui/PrincipalTitle.astro';

interface ServiceItem {
  id: string;
  title: string;
  body: string;
}

interface Props {
  what: { title: string; items: ServiceItem[] };
}

const { what } = Astro.props;

const icons: Record<string, string> = {
  security: `<path d="M8 2L3 4.5V9c0 3.3 2.1 6.4 5 7 2.9-.6 5-3.7 5-7V4.5L8 2z" stroke="currentColor" stroke-width="1.5" stroke-linejoin="round"/>`,
  urban: `<path d="M2 18h20M4 18V9l8-6 8 6v9M9 18v-5h6v5" stroke="currentColor" stroke-width="1.5" stroke-linejoin="round"/>`,
  delivery: `<path d="M9 11l3 3L22 4M21 12v7a2 2 0 01-2 2H5a2 2 0 01-2-2V5a2 2 0 012-2h11" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"/>`,
  innovation: `<circle cx="12" cy="12" r="3" stroke="currentColor" stroke-width="1.5"/><path d="M12 2v3M12 19v3M4.22 4.22l2.12 2.12M17.66 17.66l2.12 2.12M2 12h3M19 12h3M4.22 19.78l2.12-2.12M17.66 6.34l2.12-2.12" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"/>`,
};
---

<section id="what" class="section-gap bg-secondary-100">
  <div class="container-site">
    <!-- Section header -->
    <div class="mb-14 text-center">
      <PrincipalTitle>{what.title}</PrincipalTitle>
    
    </div>

    <!-- Grid -->
    <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
      {
        what.items.map((item) => (
          <article
            class="group p-8 rounded-md bg-surface border border-secondary-400 hover:border-primary-300 transition-colors duration-300"
          >
            <!-- Icon -->
            <div
              class="mb-5 w-10 h-10 flex items-center justify-center rounded-sm bg-primary-100 text-primary-500 group-hover:bg-[var(--color-primary-500)] group-hover:text-white transition-colors duration-300"
            >
              <svg
                width="20"
                height="20"
                viewBox="0 0 24 24"
                fill="none"
                aria-hidden="true"
                set:html={icons[item.id] ?? icons.delivery}
              />
            </div>

            <h3 class="type-medium text-ink mb-3">
              {item.title}
            </h3>
            <p class="type-normal text-ink-muted">{item.body}</p>
          </article>
        ))
      }
    </div>
  </div>
</section>
