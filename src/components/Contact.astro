---
import PrincipalTitle from "./ui/PrincipalTitle.astro";
import XIcon from "./ui/icons/XIcon.astro";
import InstagramIcon from "./ui/icons/InstagramIcon.astro";
import YoutubeIcon from "./ui/icons/YoutubeIcon.astro";
import LinkedinIcon from "./ui/icons/LinkedinIcon.astro";

interface ContactContent {
  title: string;
  subtitle: string;
  fields: { name: string; surname: string; email: string; message: string };
  cta: string;
}

interface Props {
  contact: ContactContent;
  lang?: "es" | "en";
}

const { contact, lang = "es" } = Astro.props;

const successMsg =
  lang === "es"
    ? "¡Mensaje enviado! Nos comunicaremos contigo pronto."
    : "Message sent! We'll be in touch soon.";

const errorMsg =
  lang === "es"
    ? "Hubo un error al enviar. Por favor intenta de nuevo."
    : "Something went wrong. Please try again.";
---

<section id="contact" class="section-gap pb-0! bg-secondary-500">
  <div class="max-w-3xl m-auto">
    <div class="text-center">
      <PrincipalTitle>{contact.title}</PrincipalTitle>
      <p class="type-normal text-ink-muted mb-8">
        {contact.subtitle}
      </p>
    </div>

    <div class="flex flex-col-reverse p-5 sm:flex-row gap-16 items-start">
      <!-- Form -->
      <div class="bg-white p-5 radius-md grow max-w-xl w-full m-auto">
        <!-- Estado: formulario -->
        <form
          id="contact-form"
          class="flex flex-col gap-5"
          name="contact"
          method="POST"
          data-netlify="true"
          netlify-honeypot="bot-field"
          novalidate
        >
          <!-- Honeypot — Netlify lo usa para filtrar spam, debe estar oculto -->
          <input type="hidden" name="form-name" value="contact" />
          <p class="hidden" aria-hidden="true">
            <label>No llenar: <input name="bot-field" /></label>
          </p>

          <!-- Name row -->
          <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
            <div class="flex flex-col gap-2">
              <label for="name" class="text-sm font-medium text-ink">
                {contact.fields.name}
              </label>
              <input
                id="name"
                name="name"
                type="text"
                required
                autocomplete="given-name"
                class="px-2 py-2 rounded-sm border border-secondary-400 bg-secondary-100 text-ink placeholder:text-ink-muted focus:border-primary-500 focus:bg-white focus:outline-none transition-colors duration-200 text-md"
              />
            </div>
            <div class="flex flex-col gap-2">
              <label for="surname" class="text-sm font-medium text-ink">
                {contact.fields.surname}
              </label>
              <input
                id="surname"
                name="surname"
                type="text"
                required
                autocomplete="family-name"
                class="px-2 py-2 rounded-sm border border-secondary-400 bg-secondary-100 text-ink placeholder:text-ink-muted focus:border-primary-500 focus:bg-white focus:outline-none transition-colors duration-200 text-md"
              />
            </div>
          </div>

          <!-- Email -->
          <div class="flex flex-col gap-2">
            <label for="email" class="text-sm font-medium text-ink">
              {contact.fields.email}
            </label>
            <input
              id="email"
              name="email"
              type="email"
              required
              autocomplete="email"
              class="px-2 py-2 rounded-sm border border-secondary-400 bg-secondary-100 text-ink placeholder:text-ink-muted focus:border-primary-500 focus:bg-white focus:outline-none transition-colors duration-200 text-md"
            />
          </div>

          <!-- Message -->
          <div class="flex flex-col gap-2">
            <label for="message" class="text-sm font-medium text-ink">
              {contact.fields.message}
            </label>
            <textarea
              id="message"
              name="message"
              required
              rows="5"
              class="px-2 py-2 rounded-sm border border-secondary-400 bg-secondary-100 text-ink placeholder:text-ink-muted focus:border-primary-500 focus:bg-white focus:outline-none transition-colors duration-200 text-md resize-y"
            ></textarea>
          </div>

          <!-- Submit -->
          <div>
            <button
              id="submit-btn"
              type="submit"
              class="inline-flex items-center gap-2 px-8 py-4 rounded-md bg-primary-500 text-white font-work text-sm no-underline hover:bg-primary-400 active:bg-primary-500 transition-colors duration-200 cursor-pointer border-none font-inherit disabled:opacity-60 disabled:cursor-not-allowed"
            >
              <span id="btn-label">{contact.cta}</span>
              <!-- Spinner (oculto por defecto) -->
              <svg
                id="btn-spinner"
                class="hidden animate-spin"
                width="16"
                height="16"
                viewBox="0 0 16 16"
                fill="none"
                aria-hidden="true"
              >
                <circle
                  cx="8"
                  cy="8"
                  r="6"
                  stroke="currentColor"
                  stroke-width="2"
                  stroke-dasharray="28"
                  stroke-dashoffset="10"
                  opacity="0.4"></circle>
                <path
                  d="M8 2a6 6 0 0 1 6 6"
                  stroke="currentColor"
                  stroke-width="2"
                  stroke-linecap="round"></path>
              </svg>
              <!-- Flecha (visible por defecto) -->
              <svg
                id="btn-arrow"
                width="16"
                height="16"
                viewBox="0 0 16 16"
                fill="none"
                aria-hidden="true"
              >
                <path
                  d="M3 8h10M9 4l4 4-4 4"
                  stroke="currentColor"
                  stroke-width="1.5"
                  stroke-linecap="round"
                  stroke-linejoin="round"></path>
              </svg>
            </button>
          </div>

          <!-- Error inline -->
          <p
            id="form-error"
            class="hidden text-sm text-red-600 mt-1"
            role="alert"
          >
            {errorMsg}
          </p>
        </form>

        <!-- Estado: éxito (oculto hasta que se confirme el envío) -->
        <div
          id="form-success"
          class="hidden flex-col items-center justify-center gap-4 py-10 text-center"
          role="status"
          aria-live="polite"
        >
          <div
            class="w-12 h-12 rounded-full bg-primary-100 flex items-center justify-center"
          >
            <svg
              width="24"
              height="24"
              viewBox="0 0 24 24"
              fill="none"
              aria-hidden="true"
            >
              <path
                d="M5 13l4 4L19 7"
                stroke="var(--color-primary-500)"
                stroke-width="2"
                stroke-linecap="round"
                stroke-linejoin="round"></path>
            </svg>
          </div>
          <p class="type-normal text-ink font-medium">{successMsg}</p>
        </div>
      </div>

      <!-- Address + social -->
      <div class="text-center sm:text-left w-full sm:w-auto">
        <div
          class="flex justify-center sm:justify-start items-center gap-2 pb-5"
        >
          <XIcon />
          <InstagramIcon />
          <YoutubeIcon />
          <LinkedinIcon />
        </div>
        <address class="not-italic text-ink-muted text-sm">
          <span>Contextual<br />Washington, DC</span>
          <br /><br />
          <a
            href="mailto:hello@itscontextual.com"
            class="text-primary-500 hover:text-primary-400 underline transition-colors duration-200"
          >
            hello@itscontextual.com
          </a>
          <br />
          <a
            href="https://itscontextual.com"
            target="_blank"
            rel="noopener noreferrer"
            class="text-ink-muted hover:text-ink no-underline transition-colors duration-200"
          >
            itscontextual.com
          </a>
        </address>
      </div>
    </div>

    <div class="flex items-center justify-center gap-2 text-ink no-underline">
      <img src="/images/logo.webp" class="w-60 my-5" />
    </div>
  </div>
</section>

<script>
  const form = document.getElementById(
    "contact-form",
  ) as HTMLFormElement | null;
  const successEl = document.getElementById("form-success");
  const errorEl = document.getElementById("form-error");
  const submitBtn = document.getElementById(
    "submit-btn",
  ) as HTMLButtonElement | null;
  const btnSpinner = document.getElementById("btn-spinner");
  const btnArrow = document.getElementById("btn-arrow");

  form?.addEventListener("submit", async (e) => {
    e.preventDefault();

    // Validación nativa del navegador primero
    if (!form.checkValidity()) {
      form.reportValidity();
      return;
    }

    // Estado: enviando
    if (submitBtn) submitBtn.disabled = true;
    btnSpinner?.classList.remove("hidden");
    btnArrow?.classList.add("hidden");
    errorEl?.classList.add("hidden");

    try {
      const data = new FormData(form);

      const res = await fetch("/", {
        method: "POST",
        headers: { "Content-Type": "application/x-www-form-urlencoded" },
        body: new URLSearchParams(data as any).toString(),
      });

      if (!res.ok) throw new Error(`HTTP ${res.status}`);

      // Éxito: ocultar form, mostrar confirmación
      form.classList.add("hidden");
      successEl?.classList.replace("hidden", "flex");
    } catch (err) {
      // Error: mostrar mensaje inline, rehabilitar botón
      errorEl?.classList.remove("hidden");
      if (submitBtn) submitBtn.disabled = false;
      btnSpinner?.classList.add("hidden");
      btnArrow?.classList.remove("hidden");
      console.error("Form submission error:", err);
    }
  });
</script>
