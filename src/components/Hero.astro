---
import { getImageUrl } from "../services/image.service";
import type { HeroContent, MediaContent,Localized } from "../types/content";
import PrincipalTitle from "./ui/PrincipalTitle.astro";
import RichText from "./ui/RichText.astro";

interface Props {
  hero: Localized<HeroContent>;
  media: MediaContent["hero"];
}

const { hero, media } = Astro.props;
---

<section id="hero" class="relative min-h-[88vh] overflow-hidden pb-10">
  <!-- Background city image (right half) -->

  <div class="relative z-10 container-site flex items-center">
    <div class="max-w-2xl">
      <!-- Headline -->
      <PrincipalTitle>
        {hero.headline}
      </PrincipalTitle>

      <!-- Body copy -->
      <div class="flex flex-col gap-4 mb-10 max-w-lg">
        <RichText class="type-normal text-ink-muted" html={hero.body} />
        <RichText class="type-normal text-ink-muted" html={hero.body2} />
      </div>

      <!-- CTA -->
      <a
        href="#contact"
        class="inline-flex items-center gap-2 px-7 py-3.5 rounded bg-primary-500 text-white type-normal no-underline hover:bg-primary-400 transition-colors duration-200 group"
      >
        {hero.cta}
        <svg
          width="16"
          height="16"
          viewBox="0 0 16 16"
          fill="none"
          aria-hidden="true"
          class="transition-transform duration-200 group-hover:translate-x-0.5"
        >
          <path
            d="M3 8h10M9 4l4 4-4 4"
            stroke="currentColor"
            stroke-width="1.5"
            stroke-linecap="round"
            stroke-linejoin="round"></path>
        </svg>
      </a>
    </div>
    <div class="pl-5 hidden md:block">
      <img src={getImageUrl(media.image)} class="max-w-md object-cover" />
    </div>
  </div>
</section>
