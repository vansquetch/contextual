---
import PrincipalTitle from "./ui/PrincipalTitle.astro";

interface HowItem {
  id: string;
  title: string;
  body: string;
}

interface Props {
  how: { title: string; items: HowItem[] };
}

const { how } = Astro.props;
---

<section id="how" class="section-gap bg-secondary-100">
  <div class="container-site">
    <!-- Section header -->
    <div class="mb-14 text-center">
      <PrincipalTitle>{how.title}</PrincipalTitle>
    </div>

    <!-- Three pillars -->
    <div class="grid grid-cols-1 md:grid-cols-3 gap-">
      {
        how.items.map((item, i) => (
          <div class={`${i === 1 ? "bg-secondary-500" : ""} p-8 md:p-10`}>
            <h3 class="mb-4 type-t4 max-w-52 leading-1">{item.title}</h3>
            <p class="type-normal">{item.body}</p>
          </div>
        ))
      }
    </div>
  </div>
</section>
