---
import { getImageUrl } from '../services/image.service';
import type { MediaContent } from '../types/content';
import PrincipalTitle from './ui/PrincipalTitle.astro';
import RichText from './ui/RichText.astro';

interface TeamMember {
  id: string;
  name: string;
  role: string;
  bio: string;
}

interface Props {
  team: { title: string; members: TeamMember[] };
  media: MediaContent["team"];
}

const { team,media } = Astro.props;

// Map member id to placeholder image path
// Replace with real photos: /images/team-{id}.jpg
---

<section id="team" class="section-gap bg-surface">
  <div class="container-site">
    <!-- Section header -->
    <div class="mb-14 text-center">
      <PrincipalTitle>{team.title}</PrincipalTitle>
      
    </div>

    <!-- Co-founders: large horizontal cards -->
    <div class="flex flex-col gap-6 mb-6">
      {
        team.members.slice(0, 2).map((member,i) => (
          <article class={`flex flex-col gap-4 p-4 rounded-md ${i==1?"bg-secondary-500 border border-secondary-400 md:flex-row-reverse":"md:flex-row"}`}>
            <!-- Photo -->
            <div class="shrink-0 w-full md:w-80 h-auto">
              <img
                src={getImageUrl(media[member.id as keyof typeof media])}
                alt={member.name}
                class="w-full h-full object-contain"
                loading="lazy"
                onerror="this.style.display='none'"
              />
            </div>

            <!-- Copy -->
            <div class="flex flex-col justify-center">
              <h3 class="type-t1 text-ink mb-4">
                {member.name}
              </h3>
              <p class="text-xs text-ink-muted font-semibold uppercase tracking-widest mb-2">
                {member.role}
              </p>
              
                <RichText class="type-normal text-ink-muted max-w-prose" html={member.bio} />
            </div>
          </article>
        ))
      }
    </div>

    <!-- Specialists: smaller cards, 2-col grid -->
    <div class="grid grid-cols-1 md:grid-cols-2 gap-6 text-black">
      {
        team.members.slice(2).map((member) => (
          <article class="flex flex-col gap-4 p-4 rounded-md  ">
              <div>
                <h3 class="type-t4  text-center mb-2">
                  {member.name}
                </h3>
                <p class="text-xs font-semibold uppercase tracking-widest mb-1 text-center">
                  {member.role}
                </p>
              </div>
              <RichText class="text-md text-ink-muted" html={member.bio} />
          </article>
        ))
      }
    </div>
  </div>
</section>
