---
interface TeamMember {
  id: string;
  name: string;
  role: string;
  bio: string;
}

interface Props {
  team: { title: string; members: TeamMember[] };
}

const { team } = Astro.props;

// Map member id to placeholder image path
// Replace with real photos: /images/team-{id}.jpg
const photoPath = (id: string) => `/images/team-${id}.webp`;
---

<section id="team" class="section-gap bg-surface">
  <div class="container-site">
    <!-- Section header -->
    <div class="mb-14">
      <h2 class="type-t4 text-ink">{team.title}</h2>
      <div
        class="mt-4 w-12 h-0.5 bg-accent-500"
        aria-hidden="true"
      ></div>
    </div>

    <!-- Co-founders: large horizontal cards -->
    <div class="flex flex-col gap-6 mb-6">
      {
        team.members.slice(0, 2).map((member) => (
          <article class="flex flex-col md:flex-row gap-8 p-8 rounded-md bg-secondary-100 border border-[var(--color-secondary-400)]">
            <!-- Photo -->
            <div class="flex-shrink-0 w-full md:w-48 h-56 md:h-auto rounded-sm overflow-hidden bg-[var(--color-secondary-300)]">
              <img
                src={photoPath(member.id)}
                alt={member.name}
                class="w-full h-full object-cover"
                loading="lazy"
                onerror="this.style.display='none'"
              />
            </div>

            <!-- Copy -->
            <div class="flex flex-col justify-center">
              <p class="type-normal text-xs text-accent-500 font-semibold uppercase tracking-widest mb-2">
                {member.role}
              </p>
              <h3 class="type-medium text-ink mb-4">
                {member.name}
              </h3>
              <p class="type-normal text-ink-muted max-w-prose">
                {member.bio}
              </p>
            </div>
          </article>
        ))
      }
    </div>

    <!-- Specialists: smaller cards, 2-col grid -->
    <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
      {
        team.members.slice(2).map((member) => (
          <article class="flex flex-col gap-6 p-8 rounded-[var(--radius-md)] bg-[var(--color-secondary-100)] border border-[var(--color-secondary-400)]">
            <!-- Photo + name row -->
            <div class="flex gap-4 items-start">
              <div class="flex-shrink-0 w-16 h-16 rounded-full overflow-hidden bg-[var(--color-secondary-300)]">
                <img
                  src={photoPath(member.id)}
                  alt={member.name}
                  class="w-full h-full object-cover"
                  loading="lazy"
                  onerror="this.style.display='none'"
                />
              </div>
              <div>
                <p class="type-normal text-xs text-accent-500 font-semibold uppercase tracking-widest mb-1">
                  {member.role}
                </p>
                <h3 class="type-medium text-ink">
                  {member.name}
                </h3>
              </div>
            </div>
            <p class="type-normal text-ink-muted">{member.bio}</p>
          </article>
        ))
      }
    </div>
  </div>
</section>
