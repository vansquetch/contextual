---
import PrincipalTitle from './ui/PrincipalTitle.astro';

interface Props {
  areas: { title: string; items: string[] };
}

const { areas } = Astro.props;
---

<section id="areas" class="section-gap raya-izquierda">
  <div class="container-site">
    <!-- Section header -->
    <div class="mb-14 text-center ">
      <PrincipalTitle>{areas.title}</PrincipalTitle>
      
    </div>

    <!-- Two-column list -->
    <ul
      class="grid grid-cols-1 md:grid-cols-2 gap-x-10 list-none"
      role="list"
    >
      {
        areas.items.map((area) => (
          <li class="flex items-start gap-4 py-5 border-b-2 border-secondary-500 pr-8">
            <!-- Dot -->
            <span
              class="mt-2.5 shrink-0 w-1.5 h-1.5 rounded-full"
              aria-hidden="true"
            />
            <span class="type-normal text-ink">{area}</span>
          </li>
        ))
      }
    </ul>
  </div>
</section>
